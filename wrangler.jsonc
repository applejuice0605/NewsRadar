{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newsradar",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./docs",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "env": {
    "preview": {
      "name": "newsradar-preview",
      "main": "./workers/preview-auth.mjs",
      "workers_dev": true,
      "preview_urls": false,
      "triggers": { "crons": [] },
      "kv_namespaces": [
        { "binding": "HEALTH_MONITOR_STATE", "id": "b3e8906ca0f9442db9640a006af2eade" }
      ],
      "routes": [
        {
          "pattern": "preview.newsradar.ccwu.cc",
          "custom_domain": true
        }
      ],
      "assets": {
        "directory": "./.deploy/preview",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash"
      }
    }
  }
}
